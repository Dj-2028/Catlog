{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,client/dist/index.html}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
