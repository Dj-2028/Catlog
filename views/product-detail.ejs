<section class="py-8 md:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-8">
            <ol class="flex items-center gap-2 text-sm">
                <li><a href="/" class="text-surface-500 hover:text-brand-400 transition-colors">Home</a></li>
                <li class="text-surface-600">/</li>
                <li><a href="/products" class="text-surface-500 hover:text-brand-400 transition-colors">Products</a>
                </li>
                <li class="text-surface-600">/</li>
                <li class="text-surface-300">
                    <%= product.name %>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
            <!-- Image Gallery -->
            <div class="space-y-4">
                <div
                    class="relative aspect-square rounded-2xl overflow-hidden bg-surface-900 border border-surface-800">
                    <% if (product.images && product.images.length> 0) { %>
                        <img id="mainImage" src="<%= product.images[0].url %>" alt="<%= product.name %>"
                            class="w-full h-full object-cover" />
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center text-surface-600">
                                <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <% } %>
                </div>

                <% if (product.images && product.images.length> 1) { %>
                    <div class="grid grid-cols-4 gap-3">
                        <% product.images.forEach((img, idx)=> { %>
                            <button onclick="document.getElementById('mainImage').src='<%= img.url %>'"
                                class="aspect-square rounded-xl overflow-hidden border-2 border-surface-700 hover:border-brand-500 transition-colors focus:outline-none focus:border-brand-500 <%= idx === 0 ? 'border-brand-500' : '' %>">
                                <img src="<%= img.url %>" alt="<%= product.name %> - Image <%= idx + 1 %>"
                                    class="w-full h-full object-cover" />
                            </button>
                            <% }) %>
                    </div>
                    <% } %>
            </div>

            <!-- Product Info -->
            <div class="flex flex-col">
                <div class="mb-4">
                    <span
                        class="inline-block px-3 py-1 rounded-lg bg-brand-500/10 text-brand-400 text-sm font-medium border border-brand-500/20">
                        <%= product.category %>
                    </span>
                </div>

                <h1 class="font-display font-bold text-3xl md:text-4xl text-white mb-3">
                    <%= product.name %>
                </h1>

                <div class="flex items-center gap-4 mb-6">
                    <span class="font-display font-bold text-3xl text-white">₹<%= product.price.toLocaleString('en-IN')
                            %></span>
                    <span class="text-surface-500 text-sm font-mono bg-surface-800 px-3 py-1 rounded-lg">SN: <%=
                            product.serialNo %></span>
                </div>

                <% if (product.description) { %>
                    <div class="mb-8">
                        <h3 class="font-display font-semibold text-white text-lg mb-3">Description</h3>
                        <p class="text-surface-400 leading-relaxed whitespace-pre-line">
                            <%= product.description %>
                        </p>
                    </div>
                    <% } %>

                        <!-- Specifications -->
                        <% if (product.specifications && Object.keys(product.specifications).length> 0) { %>
                            <div class="mb-8">
                                <h3 class="font-display font-semibold text-white text-lg mb-3">Specifications</h3>
                                <div class="rounded-xl border border-surface-800 overflow-hidden">
                                    <% Object.entries(product.specifications).forEach(([key, val], idx)=> { %>
                                        <div
                                            class="flex items-center <%= idx % 2 === 0 ? 'bg-surface-900' : 'bg-surface-800/50' %>">
                                            <span
                                                class="w-1/3 px-4 py-3 text-sm font-medium text-surface-400 border-r border-surface-800">
                                                <%= key %>
                                            </span>
                                            <span class="flex-1 px-4 py-3 text-sm text-surface-200">
                                                <%= val %>
                                            </span>
                                        </div>
                                        <% }) %>
                                </div>
                            </div>
                            <% } %>

                                <p class="text-surface-500 text-sm mb-6">
                                    Added on <%= new Date(product.dateAdded).toLocaleDateString('en-IN', {
                                        day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                                </p>

                                <!-- CTA Buttons -->
                                <div class="flex flex-col sm:flex-row gap-3 mt-auto">
                                    <a href="/about"
                                        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white font-semibold hover:from-brand-500 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 pulse-glow">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                        </svg>
                                        Inquire Now
                                    </a>
                                    <a href="/about"
                                        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-surface-800 text-surface-200 font-semibold hover:bg-surface-700 transition-all border border-surface-700">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                        </svg>
                                        Get a Quote
                                    </a>
                                </div>
            </div>
        </div>

        <!-- Back link -->
        <div class="mt-12 pt-8 border-t border-surface-800">
            <a href="/products"
                class="inline-flex items-center gap-2 text-surface-400 hover:text-brand-400 transition-colors text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to all products
            </a>
        </div>
    </div>
</section>