<!-- About Hero -->
<section class="hero-mesh relative overflow-hidden bg-[#1E2A24] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
        <div class="text-center max-w-3xl mx-auto fade-in-up">
            <span class="inline-block px-4 py-1.5 rounded-full bg-[#9A6A3A]/20 border border-[#9A6A3A]/30 text-[#C4925D] text-xs font-semibold mb-4">
                15+ Years Experience in Jabalpur
            </span>
            <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white mb-6">
                About Shiv Shakti Ply And Hardware
            </h1>
            <p class="text-[#F4F1EA]/85 text-lg leading-relaxed">
                Your trusted local destination for quality plywood, hardware supplies, paints, laminates, plumbing, sanitaryware, and electrical essentials in Jabalpur.
            </p>
        </div>
    </div>
</section>

<!-- Core Product Departments -->
<section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display font-bold text-3xl text-surface-700 dark:text-[#f5f0eb] mb-10 text-center">
            Our Key Departments
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% const capabilities=[
                { icon: '🪵' , title: 'Plywood & Sheets' , desc: 'Commercial MR and boiling waterproof BWP marine plywood sheets for modular furniture, kitchens, and wardrobes.' },
                { icon: '🔧' , title: 'Hardware Supplies' , desc: 'Architectural door locks, stainless steel handles, concealed hinges, telescopic drawer channels, and fasteners.' },
                { icon: '🎨' , title: 'Paints & Primers' , desc: 'Interior and exterior emulsion wall paints, primers, enamels, and protective timber coatings.' },
                { icon: '🪚' , title: 'Sunmica & Decorative Laminates' , desc: 'High-pressure decorative laminates, woodgrain textures, and durable surface sunmica sheets.' },
                { icon: '🚰' , title: 'Plumbing Supplies' , desc: 'CPVC & UPVC pipes, brass connectors, valves, and water drainage connections.' },
                { icon: '🚿' , title: 'Sanitaryware' , desc: 'Ceramic wash basins, modern bathroom fittings, and sanitary accessories for residential installations.' },
                { icon: '⚡' , title: 'Electrical Supplies' , desc: 'Modular switch plates, conduits, wiring supplies, and domestic electrical fittings.' },
                { icon: '🔌' , title: 'Electronics' , desc: 'Electronic accessories, installation fittings, and utility hardware.' },
                { icon: '🏠' , title: 'Interior Materials' , desc: 'Decorative louvers, wall mouldings, edge bands, and architectural finishing supplies.' }
            ]; %>
            <% capabilities.forEach(cap=> { %>
                <div class="p-6 rounded-2xl bg-white border border-surface-200 hover:border-[#9A6A3A] transition-colors group shadow-sm">
                    <span class="text-4xl block mb-4">
                        <%= cap.icon %>
                    </span>
                    <h3 class="font-display font-semibold text-surface-700 text-xl mb-2 group-hover:text-[#9A6A3A] transition-colors">
                        <%= cap.title %>
                    </h3>
                    <p class="text-surface-500 text-sm leading-relaxed">
                        <%= cap.desc %>
                    </p>
                </div>
            <% }) %>
        </div>
    </div>
</section>

