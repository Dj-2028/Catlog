<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Store Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fbf7ee', 100: '#f5ebd6', 200: '#ebd5ad', 300: '#deb87b',
                            400: '#d09b4c', 500: '#b87c2b', 600: '#9a6a3a', 700: '#7c4d22',
                            800: '#673f1f', 900: '#55341c', 950: '#301b0c',
                        },
                        forest: {
                            50: '#f4f6f4', 100: '#e5eae6', 200: '#cbd6ce', 300: '#a5b9ac',
                            400: '#789582', 500: '#54755f', 600: '#415d4a', 700: '#344b3c',
                            800: '#2b3d32', 900: '#1e2a24', 950: '#0f1713',
                        },
                        surface: {
                            50: '#fafaf9', 100: '#f5f5f4', 200: '#e7e5e4', 300: '#d6d3d1',
                            400: '#a8a29e', 500: '#78716c', 600: '#57534e',
                            700: '#44403c', 800: '#292524', 900: '#1c1917', 950: '#0c0a09'
                        },
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], display: ['Outfit', 'system-ui', 'sans-serif'] },
                },
            },
        };
    </script>
    <!-- Sync theme from main site before first paint -->
    <script>
        (function () {
            var s = localStorage.getItem('cv-theme');
            var q = window.matchMedia('(prefers-color-scheme: dark)');
            if (s === 'dark' || (!s && q.matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        .dark ::-webkit-scrollbar-track { background: #1c1917; }
        .dark ::-webkit-scrollbar-thumb { background: #44403c; border-radius: 3px; }
        .dark ::-webkit-scrollbar-thumb:hover { background: #9a6a3a; }
        html:not(.dark) ::-webkit-scrollbar-track { background: #f1f5f9; }
        html:not(.dark) ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }

        .slide-panel {
            transform: translateX(100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .slide-panel.open { transform: translateX(0); }

        .overlay {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        html:not(.dark) body, html:not(.dark) .bg-surface-950 { background-color: #f8fafc !important; }
        html:not(.dark) .bg-surface-900 { background-color: #ffffff !important; }
        html:not(.dark) .bg-surface-800 { background-color: #f1f5f9 !important; }
        html:not(.dark) .bg-surface-700 { background-color: #e2e8f0 !important; }
        html:not(.dark) .border-surface-800, html:not(.dark) .border-surface-700 { border-color: #e2e8f0 !important; }
        html:not(.dark) .text-white { color: #0f172a !important; }
        html:not(.dark) .text-surface-200 { color: #334155 !important; }
        html:not(.dark) .text-surface-400 { color: #64748b !important; }
        html:not(.dark) .text-surface-500 { color: #94a3b8 !important; }
        html:not(.dark) input:not([type=checkbox]), html:not(.dark) textarea, html:not(.dark) select {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

        .toast {
            animation: slideIn 0.3s ease, fadeOut 0.3s ease 2.7s;
        }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
    </style>
</head>

<body class="bg-surface-950 text-surface-100 font-sans antialiased">

    <!-- Top Bar -->
    <header class="fixed top-0 w-full z-50 bg-surface-900/90 backdrop-blur-xl border-b border-surface-800/50">
        <div class="flex items-center justify-between px-4 sm:px-6 h-16">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-2 group">
                    <div class="w-9 h-9 rounded-xl bg-forest-900 border border-brand-500/40 flex items-center justify-center font-display font-bold text-brand-400 text-lg shadow-sm">
                        SS
                    </div>
                    <div>
                        <span class="font-display font-bold text-white text-base tracking-tight leading-none block" id="headerStoreName">Shiv Shakti Ply And Hardware</span>
                        <span class="text-[10px] text-brand-400 font-medium uppercase tracking-wider block">Admin Management</span>
                    </div>
                </a>
            </div>
            <div class="flex items-center gap-3">
                <a href="/" target="_blank" class="px-3 py-1.5 rounded-lg border border-surface-700 hover:border-brand-500/50 text-surface-300 hover:text-white transition-colors text-xs font-medium flex items-center gap-1.5">
                    <span>View Public Store</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                <!-- Theme toggle -->
                <button id="dashThemeToggle" title="Toggle light / dark mode"
                    class="p-2 rounded-lg text-surface-500 hover:text-brand-400 transition-colors">
                    <svg id="dashIconMoon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                    <svg id="dashIconSun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </button>
                <a href="/logout"
                    class="px-3.5 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors text-xs font-medium">Logout</a>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="pt-16 min-h-screen">
        <div class="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto">

            <!-- Admin Navigation Tabs -->
            <nav class="flex items-center gap-2 border-b border-surface-800 pb-3 mb-6 overflow-x-auto text-sm">
                <button onclick="switchTab('products')" id="tabBtnProducts"
                    class="tab-btn px-4 py-2.5 rounded-xl font-medium transition-all flex items-center gap-2 bg-brand-600/15 text-brand-400 border border-brand-500/30">
                    <span>📦 Products</span>
                    <span id="tabCountProducts" class="px-2 py-0.5 rounded-full text-xs bg-surface-800 text-surface-300 font-mono">0</span>
                </button>
                <button onclick="switchTab('categories')" id="tabBtnCategories"
                    class="tab-btn px-4 py-2.5 rounded-xl font-medium transition-all flex items-center gap-2 text-surface-400 hover:text-white hover:bg-surface-800/50">
                    <span>🏷️ Categories</span>
                    <span id="tabCountCategories" class="px-2 py-0.5 rounded-full text-xs bg-surface-800 text-surface-300 font-mono">0</span>
                </button>
                <button onclick="switchTab('services')" id="tabBtnServices"
                    class="tab-btn px-4 py-2.5 rounded-xl font-medium transition-all flex items-center gap-2 text-surface-400 hover:text-white hover:bg-surface-800/50">
                    <span>🛠️ Services</span>
                    <span id="tabCountServices" class="px-2 py-0.5 rounded-full text-xs bg-surface-800 text-surface-300 font-mono">0</span>
                </button>
                <button onclick="switchTab('enquiries')" id="tabBtnEnquiries"
                    class="tab-btn px-4 py-2.5 rounded-xl font-medium transition-all flex items-center gap-2 text-surface-400 hover:text-white hover:bg-surface-800/50 relative">
                    <span>📬 Quotations & Enquiries</span>
                    <span id="enquiryBadge" class="px-2 py-0.5 rounded-full text-xs bg-brand-500 text-white font-bold font-mono">0</span>
                </button>
                <button onclick="switchTab('settings')" id="tabBtnSettings"
                    class="tab-btn px-4 py-2.5 rounded-xl font-medium transition-all flex items-center gap-2 text-surface-400 hover:text-white hover:bg-surface-800/50">
                    <span>⚙️ Store Info & Contact</span>
                </button>
            </nav>

            <!-- ================= TAB 1: PRODUCTS ================= -->
            <section id="panelProducts" class="tab-panel">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-display font-bold text-2xl text-white">Product Catalog</h2>
                        <p class="text-surface-500 text-sm" id="productCount">Loading catalog...</p>
                    </div>
                    <div class="flex items-center gap-3 w-full sm:w-auto">
                        <div class="relative flex-1 sm:w-64">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-surface-500" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="searchInput" placeholder="Search name, SKU, brand..."
                                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 placeholder-surface-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-sm" />
                        </div>
                        <button onclick="openPanel()"
                            class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white font-medium hover:from-brand-500 hover:to-brand-400 transition-all text-sm whitespace-nowrap shadow-lg shadow-brand-500/20">
                            + Add Product
                        </button>
                    </div>
                </div>

                <!-- Products Table -->
                <div class="rounded-2xl border border-surface-800 overflow-hidden bg-surface-900 shadow-sm">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-surface-800 bg-surface-800/50 text-left text-xs font-semibold text-surface-400 uppercase tracking-wider">
                                    <th class="px-4 py-3">Image</th>
                                    <th class="px-4 py-3">SKU / Code</th>
                                    <th class="px-4 py-3">Product Name</th>
                                    <th class="px-4 py-3 hidden md:table-cell">Brand</th>
                                    <th class="px-4 py-3 hidden lg:table-cell">Category</th>
                                    <th class="px-4 py-3">Price</th>
                                    <th class="px-4 py-3 hidden sm:table-cell">Availability</th>
                                    <th class="px-4 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productTableBody">
                                <tr>
                                    <td colspan="8" class="px-4 py-12 text-center text-surface-500">Loading products...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ================= TAB 2: CATEGORIES ================= -->
            <section id="panelCategories" class="tab-panel hidden">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-display font-bold text-2xl text-white">Categories</h2>
                        <p class="text-surface-500 text-sm">Organize your hardware, plywood, and materials into browseable categories.</p>
                    </div>
                    <!-- Inline Add Category -->
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <input type="text" id="newCatInput" placeholder="New category name..."
                            class="px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 placeholder-surface-500 text-sm focus:outline-none focus:border-brand-500 w-full sm:w-64" />
                        <button onclick="handleCreateCategoryDirect()"
                            class="px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-medium text-sm whitespace-nowrap transition-colors">
                            + Add Category
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="categoriesGrid">
                    <!-- Categories cards injected via JS -->
                </div>
            </section>

            <!-- ================= TAB 3: SERVICES ================= -->
            <section id="panelServices" class="tab-panel hidden">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-display font-bold text-2xl text-white">Store Services</h2>
                        <p class="text-surface-500 text-sm">Custom cutting, consultation, delivery, and hardware solutions shown dynamically on the website.</p>
                    </div>
                    <button onclick="openServicePanel()"
                        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white font-medium hover:from-brand-500 hover:to-brand-400 transition-all text-sm whitespace-nowrap shadow-lg shadow-brand-500/20">
                        + Add Service
                    </button>
                </div>

                <div class="rounded-2xl border border-surface-800 overflow-hidden bg-surface-900">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-surface-800 bg-surface-800/50 text-left text-xs font-semibold text-surface-400 uppercase tracking-wider">
                                    <th class="px-4 py-3 w-16">Order</th>
                                    <th class="px-4 py-3">Service</th>
                                    <th class="px-4 py-3 hidden md:table-cell">Short Description</th>
                                    <th class="px-4 py-3">Status</th>
                                    <th class="px-4 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="servicesTableBody">
                                <tr>
                                    <td colspan="5" class="px-4 py-12 text-center text-surface-500">Loading services...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ================= TAB 4: ENQUIRIES ================= -->
            <section id="panelEnquiries" class="tab-panel hidden">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-display font-bold text-2xl text-white">Quotations & Customer Enquiries</h2>
                        <p class="text-surface-500 text-sm">Inquiries submitted via website contact form and product quote buttons.</p>
                    </div>
                    <!-- Status Filter Tabs -->
                    <div class="flex items-center gap-1.5 p-1 bg-surface-800 rounded-xl border border-surface-700 text-xs">
                        <button onclick="filterEnquiries('all')" id="enqFilterAll" class="enq-filter px-3 py-1.5 rounded-lg font-medium bg-brand-600 text-white transition-colors">All</button>
                        <button onclick="filterEnquiries('new')" id="enqFilterNew" class="enq-filter px-3 py-1.5 rounded-lg font-medium text-surface-400 hover:text-white transition-colors">New</button>
                        <button onclick="filterEnquiries('contacted')" id="enqFilterContacted" class="enq-filter px-3 py-1.5 rounded-lg font-medium text-surface-400 hover:text-white transition-colors">Contacted</button>
                        <button onclick="filterEnquiries('closed')" id="enqFilterClosed" class="enq-filter px-3 py-1.5 rounded-lg font-medium text-surface-400 hover:text-white transition-colors">Closed</button>
                    </div>
                </div>

                <div class="rounded-2xl border border-surface-800 overflow-hidden bg-surface-900">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="border-b border-surface-800 bg-surface-800/50 text-left text-xs font-semibold text-surface-400 uppercase tracking-wider">
                                    <th class="px-4 py-3">Date</th>
                                    <th class="px-4 py-3">Customer</th>
                                    <th class="px-4 py-3">Type & Item</th>
                                    <th class="px-4 py-3 hidden md:table-cell">Qty / Req</th>
                                    <th class="px-4 py-3">Message</th>
                                    <th class="px-4 py-3">Status</th>
                                    <th class="px-4 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="enquiriesTableBody">
                                <tr>
                                    <td colspan="7" class="px-4 py-12 text-center text-surface-500">Loading enquiries...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- ================= TAB 5: STORE SETTINGS ================= -->
            <section id="panelSettings" class="tab-panel hidden">
                <div class="max-w-4xl">
                    <div class="mb-6">
                        <h2 class="font-display font-bold text-2xl text-white">Store Information & Contact Details</h2>
                        <p class="text-surface-500 text-sm">Configure store identity, phone numbers, WhatsApp, address, and Google Maps embed.</p>
                    </div>

                    <form id="storeSettingsForm" onsubmit="handleSaveSettings(event)" class="space-y-6">
                        <div class="p-6 rounded-2xl bg-surface-900 border border-surface-800 space-y-4">
                            <h3 class="font-display font-semibold text-white text-base border-b border-surface-800 pb-3">🏪 Store Identity</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Store Name</label>
                                    <input type="text" id="setStoreName" required class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Established Year</label>
                                    <input type="text" id="setEstablished" placeholder="e.g. 1998" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Tagline / Headline</label>
                                <input type="text" id="setTagline" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">About Store (Story & Description)</label>
                                <textarea id="setAbout" rows="4" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200"></textarea>
                            </div>
                        </div>

                        <div class="p-6 rounded-2xl bg-surface-900 border border-surface-800 space-y-4">
                            <h3 class="font-display font-semibold text-white text-base border-b border-surface-800 pb-3">📞 Contact & Location</h3>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Primary Phone</label>
                                    <input type="text" id="setPhone" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Alternate Phone</label>
                                    <input type="text" id="setAltPhone" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">WhatsApp Number</label>
                                    <input type="text" id="setWhatsapp" placeholder="919876543210 (digits only)" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Store Email</label>
                                    <input type="email" id="setEmail" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">GSTIN Number</label>
                                    <input type="text" id="setGstin" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200 font-mono" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Full Physical Address</label>
                                <textarea id="setAddress" rows="2" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Business Hours (one entry per line)</label>
                                <textarea id="setHours" rows="2" placeholder="Monday - Saturday: 9:00 AM – 8:30 PM&#10;Sunday: 10:00 AM – 4:00 PM" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Google Maps Embed URL (https://... or &lt;iframe&gt; code)</label>
                                <input type="text" id="setMapEmbed" placeholder="https://www.google.com/maps/embed?..." class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-sm text-surface-200" />
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 pt-2">
                            <button type="submit" id="saveSettingsBtn"
                                class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-all shadow-lg shadow-brand-500/20">
                                Save Store Settings
                            </button>
                        </div>
                    </form>
                </div>
            </section>

        </div>
    </main>

    <!-- Overlay -->
    <div id="overlay" class="overlay fixed inset-0 bg-black/60 z-50" onclick="closeAllPanels()"></div>

    <!-- ================= SLIDE-OUT PANEL: PRODUCT ================= -->
    <div id="slidePanel"
        class="slide-panel fixed top-0 right-0 h-full w-full sm:w-[520px] bg-surface-900 border-l border-surface-800 z-50 overflow-y-auto">
        <div class="p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 id="panelTitle" class="font-display font-bold text-xl text-white">Add Product</h3>
                <button onclick="closePanel()" class="p-2 rounded-lg hover:bg-surface-800 transition-colors">
                    <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <form id="productForm" enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" id="productId" value="" />
                <input type="hidden" id="existingImages" value="[]" />

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Product Name <span class="text-red-400">*</span></label>
                    <input type="text" id="formName" required placeholder="e.g. Century Club Prime Marine Plywood"
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm focus:outline-none focus:border-brand-500" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Serial / SKU <span class="text-red-400">*</span></label>
                        <input type="text" id="formSerialNo" required placeholder="PLY-CEN-01"
                            class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm font-mono focus:outline-none focus:border-brand-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Brand</label>
                        <input type="text" id="formBrand" placeholder="e.g. Brand / Manufacturer (optional)"
                            class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm focus:outline-none focus:border-brand-500" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Price (₹) <span class="text-surface-500">(0 = Quote on request)</span></label>
                        <input type="number" id="formPrice" min="0" step="0.01" placeholder="3850"
                            class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm focus:outline-none focus:border-brand-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Availability</label>
                        <select id="formAvailability" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm focus:outline-none focus:border-brand-500">
                            <option value="in_stock">In Stock</option>
                            <option value="limited">Limited Stock</option>
                            <option value="on_order">Made to Order</option>
                            <option value="out_of_stock">Out of Stock</option>
                        </select>
                    </div>
                </div>

                <div class="relative" id="categoryWrapper">
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Category</label>
                    <div class="relative">
                        <input type="text" id="formCategory" autocomplete="off" placeholder="Select or type category..."
                            class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm pr-10 focus:outline-none focus:border-brand-500" />
                        <button type="button" id="categoryDropdownBtn" class="absolute inset-y-0 right-0 px-3 flex items-center text-surface-500 hover:text-surface-300">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                    </div>
                    <div id="categoryDropdown" class="absolute z-50 w-full mt-1 bg-surface-800 border border-surface-700 rounded-xl shadow-xl hidden flex flex-col max-h-56 overflow-hidden">
                        <ul id="categoryList" class="overflow-y-auto py-1 flex-1"></ul>
                        <div class="p-2 border-t border-surface-700 hidden bg-surface-800" id="categoryAddWrapper">
                            <button type="button" id="categoryAddBtn" class="w-full text-left px-2 py-1.5 text-xs text-brand-400 hover:bg-surface-700 rounded-lg transition-colors font-medium">
                                + Add "<span id="newCategoryName"></span>"
                            </button>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Description</label>
                    <textarea id="formDescription" rows="3" placeholder="Full product details, applications, warranty..."
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm resize-none focus:outline-none focus:border-brand-500"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Specifications (e.g. Thickness, Grade, Material)</label>
                    <div id="specsContainer" class="space-y-2"></div>
                    <button type="button" onclick="addSpecRow('', '')"
                        class="mt-2 w-full px-4 py-2 rounded-xl border border-dashed border-surface-700 hover:border-brand-500 text-surface-400 hover:text-brand-400 transition-colors text-xs flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Add Specification Row
                    </button>
                </div>

                <div id="existingImagesPreview" class="hidden">
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Current Images</label>
                    <div id="existingImagesGrid" class="grid grid-cols-4 gap-2"></div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold uppercase text-surface-400">Upload Product Images</label>
                        <span id="imageCounter" class="text-xs text-surface-500">0 / 6 images</span>
                    </div>
                    <input type="file" id="formImages" multiple accept="image/*" class="hidden" onchange="handleImagePick(this)" />
                    <button type="button" onclick="document.getElementById('formImages').click()"
                        class="w-full px-4 py-5 rounded-xl border-2 border-dashed border-surface-700 hover:border-brand-500 transition-colors text-center block">
                        <svg class="w-6 h-6 mx-auto mb-1 text-surface-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span class="text-surface-500 text-xs">Choose images (auto-compressed on upload)</span>
                    </button>
                    <div id="newImagesPreview" class="grid grid-cols-4 gap-2 mt-2"></div>
                </div>

                <div class="flex items-center gap-6 pt-2">
                    <label class="flex items-center gap-2 cursor-pointer text-xs text-surface-300">
                        <input type="checkbox" id="formPublished" checked class="w-4 h-4 rounded bg-surface-800 text-brand-500" />
                        <span>Published</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer text-xs text-surface-300">
                        <input type="checkbox" id="formFeatured" class="w-4 h-4 rounded bg-surface-800 text-brand-500" />
                        <span>⭐ Featured on Home</span>
                    </label>
                </div>

                <div class="flex gap-3 pt-4 border-t border-surface-800">
                    <button type="submit" id="submitBtn"
                        class="flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-all shadow-md">
                        Save Product
                    </button>
                    <button type="button" onclick="closePanel()"
                        class="px-5 py-2.5 rounded-xl bg-surface-800 text-surface-300 font-medium text-sm hover:bg-surface-700 transition-colors">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= SLIDE-OUT PANEL: SERVICE ================= -->
    <div id="serviceSlidePanel"
        class="slide-panel fixed top-0 right-0 h-full w-full sm:w-[500px] bg-surface-900 border-l border-surface-800 z-50 overflow-y-auto">
        <div class="p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 id="servicePanelTitle" class="font-display font-bold text-xl text-white">Add Service</h3>
                <button onclick="closeServicePanel()" class="p-2 rounded-lg hover:bg-surface-800 transition-colors">
                    <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="serviceForm" onsubmit="handleServiceSubmit(event)" enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" id="serviceId" value="" />

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Service Title <span class="text-red-400">*</span></label>
                    <input type="text" id="srvTitle" required placeholder="e.g. Precision Plywood Cutting"
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm focus:outline-none focus:border-brand-500" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Display Order</label>
                        <input type="number" id="srvOrder" value="0" min="0" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Icon Key</label>
                        <select id="srvIcon" class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm">
                            <option value="saw">🪚 Saw / Cutting</option>
                            <option value="consult">🤝 Consultation</option>
                            <option value="cabinet">🗄️ Cabinet / Modular</option>
                            <option value="truck">🚛 Bulk Supply</option>
                            <option value="delivery">📦 Local Delivery</option>
                            <option value="support">🛠️ Carpenter Support</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Short Summary (Cards)</label>
                    <textarea id="srvShortDesc" rows="2" placeholder="Brief 1-2 sentence description..."
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Full Description</label>
                    <textarea id="srvDesc" rows="4" placeholder="Detailed service offering, machinery, workflow..."
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Service Highlights (one bullet per line)</label>
                    <textarea id="srvHighlights" rows="3" placeholder="Millimeter-accurate cuts&#10;Zero edge chipping&#10;Nesting optimization"
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">CTA Button Label</label>
                    <input type="text" id="srvCta" placeholder="e.g. Request Cutting Estimate"
                        class="w-full px-4 py-2.5 rounded-xl bg-surface-800 border border-surface-700 text-surface-200 text-sm" />
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-surface-400 mb-1.5">Service Cover Image</label>
                    <div id="srvImagePreview" class="mb-2 hidden">
                        <img id="srvImagePreviewImg" src="" class="w-full h-32 object-cover rounded-xl border border-surface-700" />
                    </div>
                    <input type="file" id="srvImageFile" accept="image/*" class="w-full text-xs text-surface-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-surface-800 file:text-surface-200 hover:file:bg-surface-700" />
                </div>

                <div class="pt-1">
                    <label class="flex items-center gap-2 cursor-pointer text-xs text-surface-300">
                        <input type="checkbox" id="srvIsActive" checked class="w-4 h-4 rounded bg-surface-800 text-brand-500" />
                        <span>Active (visible on website)</span>
                    </label>
                </div>

                <div class="flex gap-3 pt-4 border-t border-surface-800">
                    <button type="submit" id="srvSubmitBtn"
                        class="flex-1 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-all shadow-md">
                        Save Service
                    </button>
                    <button type="button" onclick="closeServicePanel()"
                        class="px-5 py-2.5 rounded-xl bg-surface-800 text-surface-300 font-medium text-sm hover:bg-surface-700 transition-colors">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ================= DELETE CONFIRMATION MODAL ================= -->
    <div id="deleteModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/70">
        <div class="bg-surface-900 rounded-2xl border border-surface-800 p-6 max-w-sm w-full mx-4 text-center">
            <div class="w-12 h-12 rounded-full bg-red-500/10 flex items-center justify-center mx-auto mb-4 text-red-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </div>
            <h3 class="font-display font-bold text-lg text-white mb-2" id="deleteModalTitle">Confirm Delete</h3>
            <p class="text-surface-400 text-sm mb-6" id="deleteModalMsg">Are you sure?</p>
            <div class="flex gap-3">
                <button onclick="closeDeleteModal()" class="flex-1 py-2.5 rounded-xl bg-surface-800 text-surface-300 font-medium text-sm">Cancel</button>
                <button id="confirmDeleteBtn" class="flex-1 py-2.5 rounded-xl bg-red-600 text-white font-medium text-sm hover:bg-red-500">Delete</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed bottom-4 right-4 z-[70] space-y-2"></div>

    <script src="/js/admin.js"></script>
    <script>
        // Dashboard theme toggle
        var _html = document.documentElement;
        var _dMoon = document.getElementById('dashIconMoon');
        var _dSun = document.getElementById('dashIconSun');
        function _dashApplyTheme(dark) {
            _html.classList.toggle('dark', dark);
            if (_dMoon) _dMoon.classList.toggle('hidden', dark);
            if (_dSun) _dSun.classList.toggle('hidden', !dark);
        }
        var _saved = localStorage.getItem('cv-theme');
        var _sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
        _dashApplyTheme(_saved === 'dark' || (!_saved && _sys));
        var _btn = document.getElementById('dashThemeToggle');
        if (_btn) {
            _btn.addEventListener('click', function () {
                var isDark = !_html.classList.contains('dark');
                localStorage.setItem('cv-theme', isDark ? 'dark' : 'light');
                _dashApplyTheme(isDark);
            });
        }
    </script>
</body>
</html>