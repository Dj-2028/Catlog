<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %> | CraftVault
  </title>
  <meta name="description"
    content="CraftVault — Premium custom manufactured products: key chains, trophies, gift items, visiting cards, and pamphlets." />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f5ff',
              100: '#e0eaff',
              200: '#c2d5ff',
              300: '#94b4ff',
              400: '#5c8aff',
              500: '#3366ff',
              600: '#1a4fff',
              700: '#0d3de6',
              800: '#1033b8',
              900: '#132f91',
              950: '#0d1f5e',
            },
            surface: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
              950: '#020617',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Outfit', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="bg-surface-950 text-surface-100 font-sans min-h-screen flex flex-col antialiased">

  <!-- Navigation -->
  <nav class="fixed top-0 w-full z-50 backdrop-blur-xl bg-surface-950/80 border-b border-surface-800/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div
            class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-display font-bold text-lg group-hover:scale-105 transition-transform">
            C
          </div>
          <span class="font-display font-bold text-xl text-white tracking-tight">Craft<span
              class="text-brand-400">Vault</span></span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-1">
          <a href="/" class="nav-link <%= currentPage === 'home' ? 'nav-active' : '' %>">Home</a>
          <a href="/products" class="nav-link <%= currentPage === 'products' ? 'nav-active' : '' %>">Products</a>
          <a href="/about" class="nav-link <%= currentPage === 'about' ? 'nav-active' : '' %>">About</a>
          <% if (locals.isAdmin) { %>
            <a href="/admin" class="nav-link">Dashboard</a>
            <a href="/logout"
              class="ml-2 px-4 py-2 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors text-sm font-medium">Logout</a>
            <% } %>
        </div>

        <!-- Mobile hamburger -->
        <button id="mobileMenuBtn" class="md:hidden p-2 rounded-lg hover:bg-surface-800 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <div id="mobileMenu" class="md:hidden hidden border-t border-surface-800/50">
      <div class="px-4 py-3 space-y-1">
        <a href="/"
          class="block px-3 py-2 rounded-lg text-surface-300 hover:text-white hover:bg-surface-800 transition-colors">Home</a>
        <a href="/products"
          class="block px-3 py-2 rounded-lg text-surface-300 hover:text-white hover:bg-surface-800 transition-colors">Products</a>
        <a href="/about"
          class="block px-3 py-2 rounded-lg text-surface-300 hover:text-white hover:bg-surface-800 transition-colors">About</a>
        <% if (locals.isAdmin) { %>
          <a href="/admin"
            class="block px-3 py-2 rounded-lg text-surface-300 hover:text-white hover:bg-surface-800 transition-colors">Dashboard</a>
          <a href="/logout"
            class="block px-3 py-2 rounded-lg text-red-400 hover:bg-red-500/10 transition-colors">Logout</a>
          <% } %>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1 pt-16">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="border-t border-surface-800/50 bg-surface-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <a href="/" class="flex items-center gap-2 mb-4">
            <div
              class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-display font-bold">
              C</div>
            <span class="font-display font-bold text-lg text-white">Craft<span
                class="text-brand-400">Vault</span></span>
          </a>
          <p class="text-surface-400 text-sm leading-relaxed">Premium custom manufactured products crafted with
            precision and delivered with care.</p>
        </div>
        <div>
          <h4 class="font-display font-semibold text-white mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="text-surface-400 hover:text-brand-400 transition-colors">Home</a></li>
            <li><a href="/products" class="text-surface-400 hover:text-brand-400 transition-colors">Products</a></li>
            <li><a href="/about" class="text-surface-400 hover:text-brand-400 transition-colors">About Us</a></li>
            <% if (locals.isAdmin) { %>
              <li><a href="/admin" class="text-surface-400 hover:text-brand-400 transition-colors">Dashboard</a></li>
              <li><a href="/logout" class="text-red-400/70 hover:text-red-400 transition-colors">Logout</a></li>
              <% } else { %>
                <li><a href="/login" class="text-surface-400 hover:text-brand-400 transition-colors">Admin Login</a>
                </li>
                <% } %>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-semibold text-white mb-4">Contact</h4>
          <ul class="space-y-2 text-sm text-surface-400">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              info@craftvault.com
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +91-XXXXX-XXXXX
            </li>
          </ul>
        </div>
      </div>
      <div
        class="border-t border-surface-800/50 mt-8 pt-8 flex items-center justify-center gap-3 text-surface-500 text-sm">
        <span>&copy; <%= new Date().getFullYear() %> CraftVault. All rights reserved.</span>
        <a href="<%= locals.isAdmin ? '/admin' : '/login' %>"
          class="text-surface-700 hover:text-surface-400 transition-colors" title="Admin">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </a>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>

</html>