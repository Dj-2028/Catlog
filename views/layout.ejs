<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %> | Inhouse Printing
  </title>
  <meta name="description"
    content="Inhouse Printing — Premium custom manufactured products: key chains, trophies, gift items, visiting cards, and pamphlets." />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff7ed',
              100: '#ffedd5',
              200: '#fed7aa',
              300: '#fdba74',
              400: '#fb923c',
              500: '#f97316',
              600: '#ea580c',
              700: '#c2410c',
              800: '#9a3412',
              900: '#7c2d12',
              950: '#431407',
            },
            surface: {
              50: '#fefaf6',
              100: '#fdf4e7',
              200: '#fae8cd',
              300: '#a8a29e',
              400: '#78716c',
              500: '#57534e',
              600: '#44403c',
              700: '#292524',
              800: '#f0ebe4',
              900: '#faf7f2',
              950: '#ffffff',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Nunito', 'Outfit', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <!-- Anti-flash: apply saved/system theme BEFORE first paint -->
  <script>
    (function () {
      var s = localStorage.getItem('cv-theme');
      var q = window.matchMedia('(prefers-color-scheme: dark)');
      if (s === 'dark' || (!s && q.matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body
  class="bg-surface-950 dark:bg-stone-950 text-surface-600 dark:text-stone-300 font-sans min-h-screen flex flex-col antialiased transition-colors duration-200">

  <!-- Navigation -->
  <nav
    class="fixed top-0 w-full z-50 backdrop-blur-xl bg-white/90 dark:bg-stone-900/90 border-b border-surface-200 dark:border-stone-700/50 shadow-sm dark:shadow-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div
            class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-display font-bold text-lg group-hover:scale-105 transition-transform">
            I
          </div>
          <span class="font-display font-bold text-xl text-surface-700 dark:text-stone-100 tracking-tight">Inhouse<span
              class="text-brand-500 dark:text-brand-400">Printing</span></span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-1">
          <a href="/" class="nav-link <%= currentPage === 'home' ? 'nav-active' : '' %>">Home</a>
          <a href="/products" class="nav-link <%= currentPage === 'products' ? 'nav-active' : '' %>">Products</a>
          <a href="/about" class="nav-link <%= currentPage === 'about' ? 'nav-active' : '' %>">About</a>
          <% if (locals.isAdmin) { %>
            <a href="/admin" class="nav-link">Dashboard</a>
            <a href="/logout"
              class="ml-2 px-4 py-2 rounded-lg bg-red-500/10 text-red-600 hover:bg-red-500/20 transition-colors text-sm font-medium">Logout</a>
            <% } %>
        </div>

        <!-- Mobile hamburger -->
        <button id="mobileMenuBtn"
          class="md:hidden p-2 rounded-lg text-surface-500 dark:text-stone-400 hover:bg-surface-800 dark:hover:bg-stone-800 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <div id="mobileMenu"
      class="md:hidden hidden border-t border-surface-200 dark:border-stone-700 bg-white dark:bg-stone-900">
      <div class="px-4 py-3 space-y-1">
        <a href="/"
          class="block px-3 py-2 rounded-lg text-surface-500 dark:text-stone-400 hover:text-surface-700 dark:hover:text-stone-200 hover:bg-surface-800 dark:hover:bg-stone-800 transition-colors">Home</a>
        <a href="/products"
          class="block px-3 py-2 rounded-lg text-surface-500 dark:text-stone-400 hover:text-surface-700 dark:hover:text-stone-200 hover:bg-surface-800 dark:hover:bg-stone-800 transition-colors">Products</a>
        <a href="/about"
          class="block px-3 py-2 rounded-lg text-surface-500 dark:text-stone-400 hover:text-surface-700 dark:hover:text-stone-200 hover:bg-surface-800 dark:hover:bg-stone-800 transition-colors">About</a>
        <% if (locals.isAdmin) { %>
          <a href="/admin"
            class="block px-3 py-2 rounded-lg text-surface-500 dark:text-stone-400 hover:text-surface-700 dark:hover:text-stone-200 hover:bg-surface-800 dark:hover:bg-stone-800 transition-colors">Dashboard</a>
          <a href="/logout"
            class="block px-3 py-2 rounded-lg text-red-500 dark:text-red-400 hover:bg-red-500/10 transition-colors">Logout</a>
          <% } %>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1 pt-16">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="border-t border-surface-200 dark:border-stone-700/40 bg-surface-900 dark:bg-stone-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <a href="/" class="flex items-center gap-2 mb-4">
            <div
              class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-display font-bold">
              I</div>
            <span class="font-display font-bold text-lg text-surface-700 dark:text-stone-100">Inhouse<span
                class="text-brand-500 dark:text-brand-400">Printing</span></span>
          </a>
          <p class="text-surface-500 dark:text-stone-500 text-sm leading-relaxed">Premium custom manufactured products
            crafted with
            precision and delivered with care.</p>
        </div>
        <div>
          <h4 class="font-display font-semibold text-surface-700 dark:text-stone-200 mb-4">Quick Links</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/" class="text-surface-400 hover:text-brand-400 transition-colors">Home</a></li>
            <li><a href="/products" class="text-surface-400 hover:text-brand-400 transition-colors">Products</a></li>
            <li><a href="/about" class="text-surface-400 hover:text-brand-400 transition-colors">About Us</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-display font-semibold text-surface-700 dark:text-stone-200 mb-4">Contact</h4>
          <ul class="space-y-3 text-sm text-surface-400">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-brand-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Star City, 261/C, Near Nakshtra Nagar Office,<br />Nakshtra Nagar, Katangi Rd,
                Karmeta,<br />Jabalpur, Madhya Pradesh 482002</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              info@inhouseprinting.in
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              083490 17574
            </li>
          </ul>
        </div>
      </div>
      <div
        class="border-t border-surface-200 dark:border-stone-700/40 mt-8 pt-8 flex items-center justify-center gap-3 text-surface-400 dark:text-stone-600 text-sm">
        <span class="text-surface-500 dark:text-stone-500">&copy; <%= new Date().getFullYear() %> Inhouse Printing. All
            rights
            reserved.</span>
        <!-- Admin settings link -->
        <a href="<%= locals.isAdmin ? '/admin' : '/login' %>"
          class="text-surface-300 dark:text-stone-700 hover:text-surface-500 dark:hover:text-stone-400 transition-colors"
          title="Admin">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </a>
        <!-- Theme toggle -->
        <button id="themeToggle" title="Toggle light / dark mode"
          class="text-surface-300 dark:text-stone-700 hover:text-brand-500 dark:hover:text-brand-400 transition-colors theme-toggle">
          <!-- Moon: visible in light mode → click to go dark -->
          <svg id="iconMoon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <!-- Sun: visible in dark mode → click to go light -->
          <svg id="iconSun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu
    const menuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
    }

    // ── Theme toggle ──────────────────────────────────────────
    const html = document.documentElement;
    const toggle = document.getElementById('themeToggle');
    const iconMoon = document.getElementById('iconMoon');
    const iconSun = document.getElementById('iconSun');

    function applyTheme(dark) {
      html.classList.toggle('dark', dark);
      if (iconMoon) iconMoon.classList.toggle('hidden', dark);
      if (iconSun) iconSun.classList.toggle('hidden', !dark);
    }

    // Initialise from storage or system preference (anti-flash already ran
    // in <head>, this just syncs the icon state after DOM is ready)
    var saved = localStorage.getItem('cv-theme');
    var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
    applyTheme(saved === 'dark' || (!saved && sys));

    // Button click
    if (toggle) {
      toggle.addEventListener('click', () => {
        var isDark = !html.classList.contains('dark');
        localStorage.setItem('cv-theme', isDark ? 'dark' : 'light');
        applyTheme(isDark);
      });
    }

    // Follow system changes only when user hasn't made a manual choice
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!localStorage.getItem('cv-theme')) applyTheme(e.matches);
    });
  </script>
</body>

</html>