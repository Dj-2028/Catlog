<!-- Hero Section -->
<section class="hero-mesh relative overflow-hidden bg-[#1E2A24] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="relative z-10 text-center max-w-3xl mx-auto fade-in-up">
            <div
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#9A6A3A]/20 border border-[#9A6A3A]/30 text-[#C4925D] text-sm font-medium mb-6">
                <span>★</span>
                15+ Years of Experience in Jabalpur
            </div>
            <h1
                class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl leading-tight text-white mb-6">
                Shiv Shakti Ply And Hardware
            </h1>
            <p class="text-[#F4F1EA]/85 text-lg md:text-xl leading-relaxed mb-10 max-w-2xl mx-auto">
                Quality building and interior materials in Jabalpur. Established supplier of plywood, hardware supplies, paints, laminates, plumbing, sanitaryware, and electricals.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/products"
                    class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-[#9A6A3A] text-white font-semibold hover:bg-[#7C4D22] transition-all shadow-lg shadow-[#9A6A3A]/25">
                    Browse Products
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                <a href="https://wa.me/919755672433?text=<%= encodeURIComponent('Hello Shiv Shakti Ply And Hardware, I would like to enquire about your products. Please share the details.') %>"
                    target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-[#25D366] text-white font-semibold hover:bg-[#20bd5a] transition-all">
                    WhatsApp Enquiry
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Categories Strip -->
<section class="border-y border-surface-200 bg-surface-100 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-center font-display font-bold text-2xl text-surface-800 mb-8">
            Product Categories
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
            <% const cats=[
                'Plywood',
                'Hardware supplies',
                'Paints',
                'Sunmica / decorative laminates',
                'Plumbing supplies',
                'Sanitaryware',
                'Electrical supplies',
                'Electronics',
                'Interior-related materials and supplies'
            ]; %>
            <% const icons=['🪵', '🔧', '🎨', '🪚', '🚰', '🚿', '⚡', '🔌', '🏠']; %>
            <% cats.forEach((cat, i)=> { %>
                <a href="/products?category=<%= encodeURIComponent(cat) %>"
                    class="group flex flex-col items-center gap-2 p-4 rounded-xl bg-white border border-surface-200 hover:border-[#9A6A3A] transition-all shadow-sm">
                    <span class="text-3xl mb-1">
                        <%= icons[i] %>
                    </span>
                    <span
                        class="text-xs font-semibold text-center text-surface-700 group-hover:text-[#9A6A3A] transition-colors">
                        <%= cat %>
                    </span>
                </a>
            <% }) %>
        </div>
    </div>
</section>

<!-- About Store Strip -->
<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-wider text-[#9A6A3A]">About Us</span>
        <h3 class="font-display font-bold text-3xl text-surface-800 mt-2 mb-4">
            15+ Years of Dedicated Service
        </h3>
        <p class="text-surface-600 leading-relaxed text-sm sm:text-base">
            Shiv Shakti Ply And Hardware is located on Narmada Road, Bhim Nagar, Polipather, Gwarighat, Jabalpur. We are a trusted supplier of architectural hardware, plywood, paints, sanitaryware, and electrical essentials for homeowners and carpenters.
        </p>
        <div class="mt-6 flex justify-center gap-4">
            <a href="tel:7987158644" class="px-5 py-2.5 rounded-xl bg-[#1E2A24] text-white text-xs font-semibold">
                Call: 7987158644
            </a>
            <a href="https://share.google/cPLJQiTvGPre2xRWt" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl border border-surface-300 text-surface-800 text-xs font-semibold">
                Google Maps Location
            </a>
        </div>
    </div>
</section>