<!-- Hero Section -->
<section class="hero-mesh relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="text-center max-w-3xl mx-auto fade-in-up">
            <div
                class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-sm font-medium mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
                Premium Custom Manufacturing
            </div>
            <h1
                class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl leading-tight text-surface-700 mb-6">
                Crafted with <span class="gradient-text">Precision</span>,<br />Delivered with Care
            </h1>
            <p class="text-surface-500 text-lg md:text-xl leading-relaxed mb-10 max-w-2xl mx-auto">
                Discover our exclusive collection of custom key chains, trophies, gift items, visiting cards, and
                pamphlets — all manufactured to your exact specifications.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/products"
                    class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 text-white font-semibold hover:from-brand-500 hover:to-brand-400 transition-all shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5">
                    Browse Catalog
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                <a href="/about"
                    class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-white border border-surface-200 text-surface-600 font-semibold hover:bg-surface-100 transition-all">
                    Get a Quote
                </a>
            </div>
        </div>
    </div>

    <!-- Decorative elements -->
    <div class="absolute top-20 left-10 w-72 h-72 bg-brand-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-brand-700/5 rounded-full blur-3xl"></div>
</section>

<!-- Categories Strip -->
<section class="border-y border-surface-200 bg-surface-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
            <% const cats=['Key Chains', 'Trophies' , 'Gift Items' , 'Visiting Cards' , 'Pamphlets' ]; %>
                <% const icons=['🔑', '🏆' , '🎁' , '💳' , '📄' ]; %>
                    <% cats.forEach((cat, i)=> { %>
                        <a href="/products?category=<%= encodeURIComponent(cat) %>"
                            class="group flex flex-col items-center gap-2 p-4 rounded-xl bg-white border border-surface-200 hover:border-brand-400 hover:bg-brand-50 transition-all shadow-sm">
                            <span class="text-3xl mb-1">
                                <%= icons[i] %>
                            </span>
                            <span
                                class="text-sm font-medium text-surface-500 group-hover:text-brand-600 transition-colors">
                                <%= cat %>
                            </span>
                        </a>
                        <% }) %>
        </div>
    </div>
</section>

<!-- Featured Products -->
<section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="font-display font-bold text-3xl md:text-4xl text-surface-700 mb-2">Featured Products</h2>
                <p class="text-surface-500">Our latest additions to the catalog</p>
            </div>
            <a href="/products"
                class="hidden sm:inline-flex items-center gap-1 text-brand-400 hover:text-brand-300 text-sm font-medium transition-colors">
                View All
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>

        <% if (featured.length===0) { %>
            <div class="text-center py-20">
                <div class="text-5xl mb-4">📦</div>
                <p class="text-surface-400 text-lg">No products available yet. Check back soon!</p>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
                    <% featured.forEach(product=> { %>
                        <a href="/products/<%= product.slug %>"
                            class="product-card group rounded-2xl bg-white border border-surface-200 overflow-hidden shadow-sm">
                            <div class="relative aspect-square overflow-hidden bg-surface-100">
                                <% if (product.images && product.images.length> 0) { %>
                                    <img src="<%= product.images[0].url %>" alt="<%= product.name %>"
                                        class="w-full h-full object-cover img-zoom" loading="lazy" />
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-surface-600">
                                            <svg class="w-16 h-16" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        </div>
                                        <% } %>
                                            <div class="absolute top-3 left-3">
                                                <span
                                                    class="px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-sm text-xs font-medium text-brand-600 border border-brand-200">
                                                    <%= product.category %>
                                                </span>
                                            </div>
                            </div>
                            <div class="p-4">
                                <h3
                                    class="font-display font-semibold text-surface-700 text-lg mb-1 group-hover:text-brand-600 transition-colors truncate">
                                    <%= product.name %>
                                </h3>
                                <p class="text-surface-400 text-xs mb-2">SN: <%= product.serialNo %>
                                </p>
                                <p class="text-surface-500 text-sm leading-relaxed mb-3 line-clamp-2">
                                    <%= product.description ? product.description.substring(0, 80) +
                                        (product.description.length> 80 ? '...' : '') : '' %>
                                </p>
                                <div class="flex items-center justify-between">
                                    <span class="font-display font-bold text-xl text-surface-700">₹<%=
                                            product.price.toLocaleString('en-IN') %></span>
                                    <span
                                        class="inline-flex items-center gap-1 text-brand-600 text-sm font-medium group-hover:gap-2 transition-all">
                                        View
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7" />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </a>
                        <% }) %>
                </div>
                <% } %>

                    <div class="text-center mt-10 sm:hidden">
                        <a href="/products"
                            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-surface-200 text-brand-600 font-medium hover:bg-surface-100 transition-colors">
                            View All Products
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </a>
                    </div>
    </div>
</section>

<!-- CTA Banner -->
<section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-brand-600 to-brand-800 p-8 md:p-16 text-center">
            <div class="relative z-10">
                <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">Need Custom Manufacturing?</h2>
                <p class="text-brand-200 text-lg max-w-xl mx-auto mb-8">Tell us your requirements and we'll craft
                    exactly what you need. Bulk orders welcome.</p>
                <a href="/about"
                    class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-white text-brand-700 font-semibold hover:bg-brand-50 transition-all shadow-lg">
                    Contact Us
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
            </div>
            <div
                class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl">
            </div>
            <div
                class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-2xl">
            </div>
        </div>
    </div>
</section>